{
  "name": "kanji-tower",
  "version": "1.0.0",
  "description": "合体！漢字タワー：漢字を積んで合体させる物理パズル（オンライン対戦・ランキング付き）",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "dev:api": "wrangler dev --env dev --port 8787",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply kanji-tower --env dev --local",
    "db:migrate": "wrangler d1 migrations apply kanji-tower --remote",
    "deploy:worker": "wrangler deploy"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "planck": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
