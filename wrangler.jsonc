{
  // ランキング API と対戦の部屋（Cloudflare Workers + D1 + Durable Objects）
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanji-tower-server",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kanji-tower",
      // `npx wrangler d1 create kanji-tower` で表示される ID に置き換える
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "server/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // 無料プランでは SQLite 版の Durable Object を使う
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // 公開するゲームのオリジン（パスは含めない）。カンマ区切りで複数可
    "ALLOWED_ORIGINS": "https://junnn665.github.io"
  },
  "observability": { "enabled": true },
  "env": {
    "dev": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kanji-tower",
          "database_id": "local-dev",
          "migrations_dir": "server/migrations"
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
      },
      "vars": {
        "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173"
      }
    }
  }
}
